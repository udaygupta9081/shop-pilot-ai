# Copy to .env (PowerShell: Copy-Item .env.example .env)
VITE_API_BASE_URL=http://localhost:4000/api
# Price conversion: 1 GBP = N INR (dataset prices are in GBP)
VITE_GBP_TO_INR=126.7
# "Continue with Google": the same Web client ID you put in backend/.env (GOOGLE_CLIENT_ID). It is public, not a secret.
# Leave empty to disable Google sign-in. Never put secrets in VITE_ variables.
VITE_GOOGLE_CLIENT_ID=
