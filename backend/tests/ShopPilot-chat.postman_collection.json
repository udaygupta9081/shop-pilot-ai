{
  "info": {
    "name": "ShopPilot chat pipeline",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "ragUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "email",
      "value": "postman.tester@example.com"
    },
    {
      "key": "password",
      "value": "Passw0rd!234"
    },
    {
      "key": "chatId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 Setup",
      "item": [
        {
          "name": "FastAPI health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{ragUrl}}/health",
              "host": [
                "{{ragUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register (once; 409 if it exists)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Tester\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login (sets sid cookie)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 Conversation flow",
      "item": [
        {
          "name": "1. New chat - recommendation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/conversation/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversation"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"Recommend a memory foam mattress under $300\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"has answer\", () => pm.expect(j.answer).to.be.a(\"string\").and.not.empty);",
                  "console.log(\"intent:\", j.intent, \"| products:\", (j.products||[]).map(p => p.title), \"| sources:\", (j.sources||[]).map(s => s.url), \"| summarized:\", j.summarized);",
                  "pm.collectionVariables.set(\"chatId\", j.chat._id);",
                  "pm.test(\"intent is recommendation\", () => pm.expect(j.intent).to.eql(\"product_recommendation\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Follow-up - first one",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/conversation/message/{{chatId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversation",
                "message",
                "{{chatId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"Tell me more about the first one\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"has answer\", () => pm.expect(j.answer).to.be.a(\"string\").and.not.empty);",
                  "console.log(\"intent:\", j.intent, \"| products:\", (j.products||[]).map(p => p.title), \"| sources:\", (j.sources||[]).map(s => s.url), \"| summarized:\", j.summarized);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Reviews - second one (Tavily)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/conversation/message/{{chatId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversation",
                "message",
                "{{chatId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"What are the common complaints about the second one?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"has answer\", () => pm.expect(j.answer).to.be.a(\"string\").and.not.empty);",
                  "console.log(\"intent:\", j.intent, \"| products:\", (j.products||[]).map(p => p.title), \"| sources:\", (j.sources||[]).map(s => s.url), \"| summarized:\", j.summarized);"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Compare first and second",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/conversation/message/{{chatId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversation",
                "message",
                "{{chatId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"Compare the first and second options\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"has answer\", () => pm.expect(j.answer).to.be.a(\"string\").and.not.empty);",
                  "console.log(\"intent:\", j.intent, \"| products:\", (j.products||[]).map(p => p.title), \"| sources:\", (j.sources||[]).map(s => s.url), \"| summarized:\", j.summarized);"
                ]
              }
            }
          ]
        },
        {
          "name": "5. General question (no retrieval)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/conversation/message/{{chatId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversation",
                "message",
                "{{chatId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"What does memory foam actually mean?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"has answer\", () => pm.expect(j.answer).to.be.a(\"string\").and.not.empty);",
                  "console.log(\"intent:\", j.intent, \"| products:\", (j.products||[]).map(p => p.title), \"| sources:\", (j.sources||[]).map(s => s.url), \"| summarized:\", j.summarized);"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Messages (see metadata.productReferences)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/conversation/message/{{chatId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversation",
                "message",
                "{{chatId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Chat (summary, unsummarizedMessageCount, productSets)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/conversation/{{chatId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversation",
                "{{chatId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 Edge cases",
      "item": [
        {
          "name": "Empty query -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/conversation/message/{{chatId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversation",
                "message",
                "{{chatId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"   \"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid chat id -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/conversation/message/not-an-id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversation",
                "message",
                "not-an-id"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"hi\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Idempotent send (run twice: 201 then 200 duplicate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "postman-idem-1"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/conversation/message/{{chatId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversation",
                "message",
                "{{chatId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"Which one is cheapest?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 or 200\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "console.log(\"duplicate:\", pm.response.json().duplicate === true);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 FastAPI direct (optional)",
      "item": [
        {
          "name": "Orchestrator retrieve",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{ragUrl}}/api/v1/orchestrator/retrieve",
              "host": [
                "{{ragUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orchestrator",
                "retrieve"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"Recommend a memory foam mattress under $300\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}