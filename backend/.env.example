# Copy to .env (PowerShell: Copy-Item .env.example .env) and fill in. NEVER commit .env.

# --- Required -------------------------------------------------------------
PORT=4000
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shop_pilot?retryWrites=true&w=majority
# Product catalog database (products, categories) - also what RAG/product-vector-index indexes into Qdrant.
MONGO_URI=mongodb://127.0.0.1:27017/shop_pilot
# Application database (users, sessions, conversations, messages). Falls back to MONGO_URI when empty.
MONGO_URI_USERS=mongodb://127.0.0.1:27017/shop_pilot_users
# FastAPI RAG service (RAG/): orchestration, response generation, summarization, naming.
RAG_URL=http://127.0.0.1:8000
# Address(es) of the React app allowed to call this API (comma-separated). Also used for cookies/CORS.
CLIENT_ORIGIN=http://localhost:5173

# --- Required only for "Continue with Google" -------------------------------
# Web client ID from Google Cloud Console (looks like 1234-abc.apps.googleusercontent.com). It is public, not a secret.
GOOGLE_CLIENT_ID=

# --- Optional ----------------------------------------------------------------
# development locally; set to production on your real server (turns on Secure cookies, hides error details)
NODE_ENV=development
# lax (default) works when frontend and backend share a site, e.g. localhost:5173 + localhost:4000.
# Use none ONLY if they are on different domains in production (needs HTTPS).
COOKIE_SAMESITE=lax
# Set to 1 when deployed behind a proxy/host so rate limiting sees the real visitor IP.
TRUST_PROXY=
# Chat pipeline tuning (milliseconds unless noted)
RAG_RETRIEVE_TIMEOUT_MS=75000
RAG_RESPOND_TIMEOUT_MS=75000
RAG_SUMMARY_TIMEOUT_MS=20000
RAG_NAMING_TIMEOUT_MS=10000
# Messages (user + assistant) after the summary boundary that trigger cumulative summarization
SUMMARY_THRESHOLD=10
# A stuck per-conversation lock is ignored after this long
CHAT_LOCK_TTL_MS=120000
# No longer used by login (sessions are stored in MongoDB). Kept so old setups do not break.
JWT_SECRET=
